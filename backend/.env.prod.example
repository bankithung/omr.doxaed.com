# ============================================================================
# OMRFlow — Production environment variables
# ============================================================================
# Copy this file to backend/.env (or export vars in your hosting dashboard).
# NEVER commit .env with real secrets to source control.
# Generate a secure SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ============================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DEBUG=False

# REQUIRED: long, random, unique string — generate fresh for each deployment
DJANGO_SECRET_KEY=<generate-a-50-char-random-string>

# Comma-separated list of your public domain(s)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ---------------------------------------------------------------------------
# Database  (PostgreSQL required in production)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://db_user:db_password@db_host:5432/omrflow

# ---------------------------------------------------------------------------
# CORS / Frontend
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ---------------------------------------------------------------------------
# HTTPS / Security headers
# ---------------------------------------------------------------------------
# Set True once TLS is working end-to-end via Nginx.
SECURE_SSL_REDIRECT=True
# 31536000 = 1 year; add only after confirming HTTPS works for all subdomains.
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ---------------------------------------------------------------------------
# Email (SMTP — replace with your provider's credentials)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=<your-smtp-api-key>
DEFAULT_FROM_EMAIL=DoxaEd OMR <doxaed@gmail.com>

# ---------------------------------------------------------------------------
# PII field encryption
# CRITICAL: once set and data is written this key MUST remain constant.
# Rotating it orphans all encrypted student names.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=<generate-a-fernet-key-and-never-change-it>

# ---------------------------------------------------------------------------
# Razorpay payment gateway
# Obtain from https://dashboard.razorpay.com/app/keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>

# ---------------------------------------------------------------------------
# Celery / Redis (async task queue)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis-host:6379/0
# CELERY_RESULT_BACKEND is optional — omit unless you need result inspection
# CELERY_RESULT_BACKEND=redis://redis-host:6379/1

# IMPORTANT: set False in production so tasks run asynchronously.
# (Default is True in dev/tests so no broker is needed locally.)
CELERY_TASK_ALWAYS_EAGER=False

# ---------------------------------------------------------------------------
# Login lockout (django-axes)
# ---------------------------------------------------------------------------
AXES_FAILURE_LIMIT=5
# AXES_ENABLED=True  # (default) — set False only for debugging
