DJANGO_SECRET_KEY=replace-with-a-50-char-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@localhost:5432/omrflow
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
FIELD_ENCRYPTION_KEY=replace-with-output-of-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key().decode()
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_SECRET
RAZORPAY_WEBHOOK_SECRET=whsec_test

# --- Google Sign-In (optional) ---
# Paste your Google Cloud OAuth 2.0 *Web application* Client ID here.
# Only the Client ID is needed to verify ID tokens — the client SECRET is NOT required.
# Leave empty to keep Google sign-in disabled (the button hides; endpoint returns 503).
GOOGLE_CLIENT_ID=

# --- Production security (set these when DEBUG=False) ---
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- django-axes login lockout ---
# AXES_ENABLED=True
# AXES_FAILURE_LIMIT=5

# --- Celery async task queue (eager/inline in dev, async in prod) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=True   # set False in production
